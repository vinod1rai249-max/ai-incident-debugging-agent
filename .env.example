# LLM Providers
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
MODEL_NAME=claude-sonnet-4-6

# Vector Store
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Application
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO
LOG_PROMPTS=false            # set true only in development for prompt debugging

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RATE_LIMIT=100           # requests per minute per IP

# Incident Debugger
INCIDENT_MAX_COST_USD=0.10   # per-incident USD ceiling
INCIDENT_TIMEOUT_S=60        # full pipeline timeout in seconds

# Dynatrace / OpenTelemetry tracing
DT_TOKEN=your-dynatrace-api-token-here
OTEL_EXPORTER_OTLP_ENDPOINT=https://<tenant>.live.dynatrace.com/api/v2/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Api-Token your-dynatrace-api-token-here
OTEL_SERVICE_NAME=production-incident-debugging-agent
